{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [
      "chrome",
      "vite/client",
      "bun"
    ],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
