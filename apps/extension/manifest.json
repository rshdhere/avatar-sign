{
  "manifest_version": 3,
  "name": "signside",
  "description": "A sign language avatar beside YouTube videos.",
  "version": "0.1.0",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Open signside",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "src/background.ts", "type": "module" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["src/content.ts"] }],
  "permissions": ["sidePanel"],
  "host_permissions": ["https://www.youtube.com/*"]
}
